# ==========================================
# Секреты и переменные окружения (НИКОГДА НЕ КОММИТИТЬ!)
# ==========================================
.env
.env.local
.env.*.local
.env.*
!.env.example

# ==========================================
# Виртуальное окружение Python
# ==========================================
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/

# ==========================================
# Байткод и кэши Python
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# ==========================================
# Служебные файлы ОС
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ==========================================
# Настройки редакторов и IDE
# ==========================================
.idea/
.vscode/
*.swp
*.swo

# ==========================================
# Экспортированные файлы и дампы
# ==========================================
*.pdf
*.log

# ==========================================
# Отчёты плейтестов (хранятся только локально)
# ==========================================
reports/*
!reports/.gitkeep
